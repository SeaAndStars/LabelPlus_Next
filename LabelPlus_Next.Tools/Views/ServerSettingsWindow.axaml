<u:UrsaWindow
    x:Class="LabelPlus_Next.Tools.Views.ServerSettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="clr-namespace:LabelPlus_Next.Tools.ViewModels"
    x:DataType="vm:ServerSettingsViewModel"
    Width="480" SizeToContent="Height" Title="服务器设置">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="WebDAV BaseUrl (AList 通常为 https://主机/dav/)"/>
        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="API BaseUrl (e.g. https://host)"/>
        <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Username"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Password"/>
        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Default Target Path (DAV)"/>
        <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="保存" Command="{Binding SaveCommand}"/>
            <Button Content="关闭" Click="OnCloseClick"/>
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Foreground="Gray"
                Text="{Binding SavedMessage}"/>
        </StackPanel>
    </StackPanel>
</u:UrsaWindow>
