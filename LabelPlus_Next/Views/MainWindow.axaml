<u:UrsaWindow
    xmlns:lang="clr-namespace:LabelPlus_Next.Lang"
    x:Class="LabelPlus_Next.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:cc="clr-namespace:LabelPlus_Next.CustomControls"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    Title="LabelPlus_Next"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="False"
    IsTitleBarVisible="False"
    Width="1300"
    Height="800"
    d:DesignHeight="800"
    d:DesignWidth="1300"
    Focusable="True"
    Icon="/Assets/LabelPlus_Next_rounded_icon_transparent.ico"
    mc:Ignorable="d">


    <Grid RowDefinitions="Auto,*">
        <cc:ChromeTitleBar Grid.Row="0" Title="LabelPlus Next" />

        <Grid
            Grid.Row="1"
            x:Name="RootGrid"
            ColumnDefinitions="auto,*"
            RowDefinitions="*">

        <!--  侧边栏  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource LpSurfaceBrush}"
            BorderBrush="{DynamicResource LpCardBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel
                    x:Name="Brand"
                    Margin="18,18,18,10"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image
                        Width="30"
                        Height="30"
                        Source="{DynamicResource AppLogoSource}" />
                    <StackPanel x:Name="BrandText" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold" Text="LabelPlus Next" />
                        <TextBlock Classes="lp-subtle" FontSize="11" Text="{I18N {x:Static lang:LangKeys.ui0001}}" />
                    </StackPanel>
                </StackPanel>

                <u:NavMenu
                    x:Name="NavMenuMain"
                    Grid.Row="1"
                    IsHorizontalCollapsed="False"
                    SelectionChanged="OnNavSelectionChanged">

                    <u:NavMenuItem
                        Header="{I18N {x:Static lang:LangKeys.ui0002}}"
                        Tag="toggle">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconChevronLeft}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <u:NavMenuItem
                        Header="{I18N {x:Static lang:LangKeys.ui0003}}"
                        Tag="translate">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconLanguage}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <u:NavMenuItem
                        Header="{I18N {x:Static lang:LangKeys.ui0004}}"
                        Tag="proof">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconTickCircle}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <u:NavMenuItem
                        Header="{I18N {x:Static lang:LangKeys.ui0005}}"
                        Tag="teamwork">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconUserGroup}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <!-- 上传菜单项由代码在鉴权通过后动态插入，不在 XAML 中定义 -->
                    <u:NavMenuItem
                        Header="{I18N {x:Static lang:LangKeys.ui0006}}"
                        Tag="deliver">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconSend}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                </u:NavMenu>

                <u:NavMenu
                    x:Name="NavMenuFooter"
                    Grid.Row="2"
                    Margin="0,0,0,10"
                    SelectionChanged="OnNavSelectionChanged">
                    <u:NavMenuItem
                        Header="{I18N {x:Static lang:LangKeys.ui0007}}"
                        Tag="settings">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconSetting}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                </u:NavMenu>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="14"
            BorderThickness="0">
            <ContentControl x:Name="NavContent" />
        </Border>
    </Grid>
    </Grid>
</u:UrsaWindow>
