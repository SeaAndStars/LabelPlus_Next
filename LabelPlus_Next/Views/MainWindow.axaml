<u:UrsaWindow
    x:Class="LabelPlus_Next.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
    Title="LabelPlus_Next"
    Width="1300"
    Height="800"
    d:DesignHeight="800"
    d:DesignWidth="1300"
    Focusable="True"
    Icon="/Assets/LabelPlus_Next_rounded_icon_transparent.ico"
    mc:Ignorable="d">


    <Grid
        x:Name="RootGrid"
        ColumnDefinitions="auto,*"
        RowDefinitions="*">

        <!--  侧边栏  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource LpSurfaceBrush}"
            BorderBrush="{DynamicResource LpCardBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel
                    x:Name="Brand"
                    Margin="18,18,18,10"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image
                        Width="30"
                        Height="30"
                        Source="/Assets/LabelPlus_Next_rounded_icon_transparent.ico" />
                    <StackPanel x:Name="BrandText" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold" Text="LabelPlus Next" />
                        <TextBlock Classes="lp-subtle" FontSize="11" Text="漫画翻译工作台" />
                    </StackPanel>
                </StackPanel>

                <u:NavMenu
                    x:Name="NavMenuMain"
                    Grid.Row="1"
                    IsHorizontalCollapsed="False"
                    SelectionChanged="OnNavSelectionChanged">

                    <u:NavMenuItem
                        Header="收起"
                        Tag="toggle">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconChevronLeft}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <u:NavMenuItem
                        Header="翻译"
                        Tag="translate">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconLanguage}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <u:NavMenuItem
                        Header="校对"
                        Tag="proof">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconTickCircle}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <u:NavMenuItem
                        Header="协作"
                        Tag="teamwork">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconUserGroup}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                    <!-- 上传菜单项由代码在鉴权通过后动态插入，不在 XAML 中定义 -->
                    <u:NavMenuItem
                        Header="交付"
                        Tag="deliver">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconSend}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                </u:NavMenu>

                <u:NavMenu
                    x:Name="NavMenuFooter"
                    Grid.Row="2"
                    Margin="0,0,0,10"
                    SelectionChanged="OnNavSelectionChanged">
                    <u:NavMenuItem
                        Header="设置"
                        Tag="settings">
                        <u:NavMenuItem.Icon>
                            <PathIcon Width="16" Height="16" Data="{StaticResource SemiIconSetting}" />
                        </u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                </u:NavMenu>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="14"
            BorderThickness="0">
            <ContentControl x:Name="NavContent" />
        </Border>
    </Grid>
</u:UrsaWindow>
