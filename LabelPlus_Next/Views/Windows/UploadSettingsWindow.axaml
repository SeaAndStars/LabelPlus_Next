<u:UrsaWindow
    x:Class="LabelPlus_Next.Views.Windows.UploadSettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:LabelPlus_Next.CustomControls"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="clr-namespace:LabelPlus_Next.ViewModels"
    Title="上传设置"
    WindowStartupLocation="CenterOwner"
    Width="460"
    Height="454"
    x:DataType="vm:UploadSettingsViewModel"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="False"
    IsTitleBarVisible="False">
    <Grid RowDefinitions="Auto,*">
        <cc:ChromeTitleBar Grid.Row="0" Title="上传设置" />

        <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="2">
            <TextBlock Classes="lp-page-title" Text="上传设置" />
            <TextBlock Classes="lp-subtle" Text="配置上传服务器的地址与账号信息。" />
        </StackPanel>

        <Border Grid.Row="1" Classes="lp-card">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Classes="lp-label" Text="服务器地址 (BaseUrl)" />
                    <TextBox Text="{Binding BaseUrl, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="lp-label" Text="用户名" />
                    <TextBox Text="{Binding Username, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="lp-label" Text="密码" />
                    <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="•" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="关闭" IsCancel="True" MinWidth="88" />
            <Button Click="OnSaveAndRefreshClick" Content="保存并刷新" MinWidth="112" />
            <Button Classes="lp-primary" Command="{Binding SaveCommand}" Content="保存" MinWidth="88" />
        </StackPanel>
    </Grid>
    </Grid>
</u:UrsaWindow>
