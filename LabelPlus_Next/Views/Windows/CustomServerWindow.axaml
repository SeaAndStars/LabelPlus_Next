<u:UrsaWindow
    xmlns:lang="clr-namespace:LabelPlus_Next.Lang"
    x:Class="LabelPlus_Next.Views.Windows.CustomServerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:LabelPlus_Next.CustomControls"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="clr-namespace:LabelPlus_Next.ViewModels"
    Title="{I18N {x:Static lang:LangKeys.ui0068}}"
    WindowStartupLocation="CenterOwner"
    Width="560"
    Height="574"
    x:DataType="vm:SettingsViewModel"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="False"
    IsTitleBarVisible="False">
    <Grid RowDefinitions="Auto,*">
        <cc:ChromeTitleBar Grid.Row="0" Title="{I18N {x:Static lang:LangKeys.ui0068}}" />

        <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="2">
            <TextBlock Classes="lp-page-title" Text="{I18N {x:Static lang:LangKeys.ui0068}}" />
            <TextBlock Classes="lp-subtle" Text="{I18N {x:Static lang:LangKeys.ui0069}}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="lp-card">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Classes="lp-label" Text="Base Url" />
                    <TextBox Text="{Binding BaseUrl}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="lp-label" Text="{I18N {x:Static lang:LangKeys.ui0070}}" />
                    <TextBox Text="{Binding ManifestPath}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="lp-label" Text="{I18N {x:Static lang:LangKeys.ui0071}}" />
                    <TextBox Text="{Binding Username}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="lp-label" Text="{I18N {x:Static lang:LangKeys.ui0072}}" />
                    <TextBox Text="{Binding Password}" PasswordChar="•" />
                </StackPanel>
                <TextBlock Classes="lp-subtle" Text="{Binding Status}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Click="OnVerifyClick" Content="{I18N {x:Static lang:LangKeys.ui0073}}" MinWidth="96" />
            <Button Classes="lp-primary" Command="{Binding SaveCommand}" Content="{I18N {x:Static lang:LangKeys.ui0074}}" MinWidth="140" />
        </StackPanel>
    </Grid>
    </Grid>
</u:UrsaWindow>
