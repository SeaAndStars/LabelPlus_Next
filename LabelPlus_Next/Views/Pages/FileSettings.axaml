<u:UrsaWindow
    x:Class="LabelPlus_Next.Views.Pages.FileSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:LabelPlus_Next.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:LabelPlus_Next.Lang"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:viewModels="clr-namespace:LabelPlus_Next.ViewModels"
    Title="{I18N {x:Static lang:LangKeys.ui0114}}"
    WindowStartupLocation="CenterOwner"
    Width="640"
    Height="494"
    d:DesignHeight="494"
    d:DesignWidth="640"
    x:DataType="viewModels:FileSettingsViewModel"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="False"
    IsTitleBarVisible="False"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*">
        <cc:ChromeTitleBar Grid.Row="0" Title="{I18N {x:Static lang:LangKeys.ui0114}}" />

        <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="2">
            <TextBlock Classes="lp-page-title" Text="{I18N {x:Static lang:LangKeys.ui0114}}" />
            <TextBlock Classes="lp-subtle" Text="{I18N {x:Static lang:LangKeys.ui0148}}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="lp-card">
            <Grid ColumnDefinitions="240,*" ColumnSpacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Classes="lp-section-title" Text="{I18N {x:Static lang:LangKeys.labelGroup}}" />
                    <ListBox
                        MinHeight="240"
                        ItemsSource="{Binding GroupList, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Classes="lp-section-title" Text="{I18N {x:Static lang:LangKeys.ui0045}}" />
                    <TextBox
                        MinHeight="240"
                        AcceptsReturn="True"
                        Text="{Binding Notes, Mode=TwoWay}"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button
                Classes="lp-primary"
                Click="Save"
                Content="{I18N {x:Static lang:LangKeys.button_OK}}"
                MinWidth="96" />
        </StackPanel>
    </Grid>
    </Grid>
</u:UrsaWindow>
