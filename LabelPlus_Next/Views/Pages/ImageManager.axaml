<u:UrsaWindow
    x:Class="LabelPlus_Next.Views.Pages.ImageManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:LabelPlus_Next.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:LabelPlus_Next.Lang"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:viewModels="clr-namespace:LabelPlus_Next.ViewModels"
    Title="管理图片"
    Width="760"
    Height="614"
    d:DesignHeight="614"
    d:DesignWidth="760"
    x:DataType="viewModels:ImageManagerViewModel"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="False"
    IsTitleBarVisible="False"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*">
        <cc:ChromeTitleBar Grid.Row="0" Title="管理图片" />

        <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="2">
            <TextBlock Classes="lp-page-title" Text="管理图片" />
            <TextBlock Classes="lp-subtle" Text="选择要包含在翻译文件中的图片，左右移动即可调整顺序。" />
        </StackPanel>

        <Border Grid.Row="1" Classes="lp-card">
            <Grid ColumnDefinitions="*,120,*" ColumnSpacing="16">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Classes="lp-section-title" Text="{I18N {x:Static lang:LangKeys.labelFolderFile}}" />
                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding FileFolderList, Mode=TwoWay}"
                        SelectedItem="{Binding SelectedFolerFile}" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="SelectOneFile"
                        Content="添加 →" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="SelectAllFile"
                        Content="全部添加 ⇉" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="UnselectOneFile"
                        Content="← 移除" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="UnselectAllFile"
                        Content="⇇ 全部移除" />
                </StackPanel>

                <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Classes="lp-section-title" Text="{I18N {x:Static lang:LangKeys.labelIncludedFile}}" />
                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding FileList, Mode=TwoWay}"
                        SelectedItem="{Binding SelectedFile}" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button
                Click="OnCancelClick"
                Content="{I18N {x:Static lang:LangKeys.buttonCancel}}"
                MinWidth="96" />
            <Button
                Classes="lp-primary"
                Click="OnOkClick"
                Content="{I18N {x:Static lang:LangKeys.button_OK}}"
                MinWidth="96" />
        </StackPanel>
    </Grid>
    </Grid>
</u:UrsaWindow>
