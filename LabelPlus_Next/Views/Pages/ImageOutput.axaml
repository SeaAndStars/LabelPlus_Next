<u:UrsaWindow
    x:Class="LabelPlus_Next.Views.Pages.ImageOutput"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:LabelPlus_Next.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang1="clr-namespace:LabelPlus_Next.Lang"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    Title="导出图片"
    WindowStartupLocation="CenterOwner"
    Width="400"
    Height="394"
    d:DesignHeight="394"
    d:DesignWidth="400"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="False"
    IsTitleBarVisible="False"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*">
        <cc:ChromeTitleBar Grid.Row="0" Title="导出图片" />

        <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="2">
            <TextBlock Classes="lp-page-title" Text="导出图片" />
            <TextBlock Classes="lp-subtle" Text="将当前译文渲染到图片后导出。" />
        </StackPanel>

        <Border Grid.Row="1" Classes="lp-card">
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Text="{I18N {x:Static lang1:LangKeys.labelOutputFormat}}" />
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="16">
                    <RadioButton
                        Content="PNG"
                        IsChecked="True" />
                    <RadioButton Content="JPG" />
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Text="{I18N {x:Static lang1:LangKeys.labelZoom}}" />
                <MaskedTextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Width="120"
                    Mask="0.00"
                    Text="1.00" />

                <CheckBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Content="{I18N {x:Static lang1:LangKeys.checkBoxJumpNoNum}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="10">
            <ProgressBar
                x:Name="ProgressBar"
                Height="6"
                MaxWidth="360"
                HorizontalAlignment="Stretch"
                ShowProgressText="True" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button
                    Classes="lp-danger"
                    Content="{I18N {x:Static lang1:LangKeys.buttonAbort}}"
                    MinWidth="96" />
                <Button
                    Classes="lp-primary"
                    Content="{I18N {x:Static lang1:LangKeys.button_start}}"
                    MinWidth="96" />
            </StackPanel>
        </StackPanel>
    </Grid>
    </Grid>
</u:UrsaWindow>
