<UserControl x:Class="LabelPlus_Next.Views.Pages.SettingsPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:LabelPlus_Next.Lang"
             xmlns:models="clr-namespace:LabelPlus_Next.Models"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="clr-namespace:LabelPlus_Next.ViewModels"
             x:DataType="vm:SettingsViewModel" MinHeight="350" MinWidth="600">
    <ScrollViewer>
        <StackPanel Margin="20" MinWidth="760" MaxWidth="920" HorizontalAlignment="Center" Spacing="16">
            <StackPanel Spacing="2">
                <TextBlock Text="{I18N {x:Static lang:LangKeys.ui0007}}" Classes="lp-page-title" />
                <TextBlock Text="{I18N {x:Static lang:LangKeys.ui0075}}" Classes="lp-subtle" />
            </StackPanel>

            <Border Classes="lp-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{I18N {x:Static lang:LangKeys.settingsLanguageAppearanceTitle}}" Classes="lp-section-title" />
                        <TextBlock Text="{I18N {x:Static lang:LangKeys.settingsLanguageAppearanceDescription}}" Classes="lp-subtle" />
                    </StackPanel>

                    <Grid ColumnDefinitions="90,Auto,Auto,*" ColumnSpacing="12">
                        <TextBlock
                            Text="{I18N {x:Static lang:LangKeys.settingsLanguageLabel}}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            Width="260"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LanguageOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            Grid.Column="2"
                            Classes="lp-primary"
                            Command="{Binding SaveCommand}"
                            Content="{I18N {x:Static lang:LangKeys.buttonSave}}" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource LpCardBorderBrush}" />

                    <Grid ColumnDefinitions="90,Auto,Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                        <TextBlock
                            Text="{I18N {x:Static lang:LangKeys.settingsThemeLabel}}"
                            VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource LpSurfaceBrush}"
                            BorderBrush="{DynamicResource LpCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <u:ThemeToggleButton
                                Width="32"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsThreeState="True"
                                SelectedTheme="{Binding SelectedTheme, Mode=TwoWay}"
                                ToolTip.Tip="{I18N {x:Static lang:LangKeys.settingsThemeHint}}" />
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            MinWidth="72"
                            Text="{Binding ThemeDisplayName}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="3"
                            Classes="lp-subtle"
                            FontSize="12"
                            Text="{I18N {x:Static lang:LangKeys.settingsThemeHint}}"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="lp-card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{I18N {x:Static lang:LangKeys.ui0076}}" Classes="lp-section-title" />
                        <TextBlock Text="{I18N {x:Static lang:LangKeys.ui0077}}" Classes="lp-subtle" />
                    </StackPanel>
                    <Grid ColumnDefinitions="190,*,64" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                        <TextBlock Grid.Row="0" Text="{I18N {x:Static lang:LangKeys.ui0078}}" VerticalAlignment="Center" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0.5" Maximum="2.5" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Value="{Binding LabelIndexFontScale, Mode=TwoWay}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LabelIndexFontScale, StringFormat={}{0:0.0}x}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="{I18N {x:Static lang:LangKeys.ui0079}}" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="2.5" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Value="{Binding LabelTipFontScale, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LabelTipFontScale, StringFormat={}{0:0.0}x}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="{I18N {x:Static lang:LangKeys.ui0080}}" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" Value="{Binding LabelTipBackgroundOpacity, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LabelTipBackgroundOpacity, StringFormat={}{0:P0}}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Button Classes="lp-primary" Content="{I18N {x:Static lang:LangKeys.ui0081}}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 更新 -->
            <Border Classes="lp-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{I18N {x:Static lang:LangKeys.ui0082}}" Classes="lp-section-title" />
                            <TextBlock Text="{I18N {x:Static lang:LangKeys.ui0083}}" Classes="lp-subtle" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="{I18N {x:Static lang:LangKeys.ui0047}}" Command="{Binding CancelUpdateCommand}" IsVisible="{Binding IsUpdating}" />
                            <Button Content="{I18N {x:Static lang:LangKeys.ui0084}}" Classes="lp-primary"
                                    Command="{Binding CheckUpdateCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{I18N {x:Static lang:LangKeys.ui0085}}" Classes="lp-subtle" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentClientVersion, FallbackValue=—, TargetNullValue=—}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{I18N {x:Static lang:LangKeys.ui0086}}" Classes="lp-subtle" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding LatestClientVersion, FallbackValue=—, TargetNullValue=—}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{I18N {x:Static lang:LangKeys.ui0087}}" Classes="lp-subtle" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentUpdaterVersion, FallbackValue=—, TargetNullValue=—}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{I18N {x:Static lang:LangKeys.ui0088}}" Classes="lp-subtle" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding LatestUpdaterVersion, FallbackValue=—, TargetNullValue=—}" FontWeight="SemiBold" />
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding IsUpdating}">
                        <TextBlock Text="{Binding UpdateTask}" />
                        <ProgressBar Minimum="0" Maximum="100" Height="8"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding UpdateProgress}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Classes="lp-subtle" />

                    <Expander Header="{I18N {x:Static lang:LangKeys.ui0089}}" IsVisible="{Binding UpdateNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <SelectableTextBlock Text="{Binding UpdateNotes}" TextWrapping="Wrap" />
                    </Expander>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{I18N {x:Static lang:LangKeys.ui0090}}" Click="OnOpenCustomServerClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 开发者选项 -->
            <Border Classes="lp-card">
                <Expander Header="{I18N {x:Static lang:LangKeys.ui0091}}">
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <TextBlock Text="{I18N {x:Static lang:LangKeys.ui0092}}" Classes="lp-section-title" />
                        <TextBlock Text="{I18N {x:Static lang:LangKeys.ui0093}}" Classes="lp-subtle" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Text="{I18N {x:Static lang:LangKeys.ui0094}}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding DeeplinkCallbackUrl, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Text="Authorization" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeeplinkCallbackAuth, Mode=TwoWay}"
                                     ToolTip.Tip="{I18N {x:Static lang:LangKeys.ui0095}}" />
                        </Grid>
                        <CheckBox Content="{I18N {x:Static lang:LangKeys.ui0096}}" IsChecked="{Binding AllowLocalHttpFallback, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="lp-primary" Content="{I18N {x:Static lang:LangKeys.ui0097}}" Command="{Binding SaveCommand}" />
                            <Button Content="{I18N {x:Static lang:LangKeys.ui0098}}" Classes="Danger" Click="OnThrowUnhandledClick" ToolTip.Tip="{I18N {x:Static lang:LangKeys.ui0099}}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
