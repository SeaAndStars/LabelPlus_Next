<u:UrsaWindow
    xmlns:lang="clr-namespace:LabelPlus_Next.Lang"
    x:Class="LabelPlus_Next.Views.Pages.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:LabelPlus_Next.CustomControls"
    xmlns:u="https://irihi.tech/ursa"
    Title="{I18N {x:Static lang:LangKeys.ui0149}}"
    WindowStartupLocation="CenterOwner"
    Width="520"
    Height="654"
    UseLayoutRounding="True"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="0"
    IsTitleBarVisible="False">
    <Grid RowDefinitions="Auto,*">
        <cc:ChromeTitleBar Grid.Row="0" Title="{I18N {x:Static lang:LangKeys.ui0149}}" />

        <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
            <Image
                Width="72"
                Height="72"
                RenderOptions.BitmapInterpolationMode="HighQuality"
                Source="{DynamicResource AppLogoSource}" />
            <TextBlock
                HorizontalAlignment="Center"
                Classes="lp-page-title"
                Text="LabelPlus Next" />
            <TextBlock
                x:Name="VersionText"
                HorizontalAlignment="Center"
                Classes="lp-subtle"
                Text="{I18N {x:Static lang:LangKeys.ui0150}}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="lp-card">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <TextBlock Classes="lp-label" Text="{I18N {x:Static lang:LangKeys.ui0151}}" />
                    <TextBlock Grid.Column="1" Text="SeaStar" />
                    <TextBlock Grid.Row="1" Classes="lp-label" Text="{I18N {x:Static lang:LangKeys.ui0152}}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Classes="link"
                        Foreground="{DynamicResource LpPrimaryBrush}"
                        PointerPressed="OnProjectLinkPressed"
                        Text="https://github.com/SeaAndStars/LabelPlus_Next"
                        TextDecorations="Underline"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Separator />
                <TextBlock Classes="lp-section-title" Text="{I18N {x:Static lang:LangKeys.ui0153}}" />
                <Image
                    Height="140"
                    HorizontalAlignment="Center"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Source="avares://LabelPlus_Next/Assets/20210801GreenTealogo.png"
                    Stretch="Uniform" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="lp-subtle"
                    Text="{I18N {x:Static lang:LangKeys.ui0154}}" />
            </StackPanel>
        </Border>

        <Button
            Grid.Row="2"
            Classes="lp-primary"
            Click="OnCloseClick"
            Content="{I18N {x:Static lang:LangKeys.ui0028}}"
            HorizontalAlignment="Right"
            MinWidth="96" />
    </Grid>
    </Grid>
</u:UrsaWindow>
